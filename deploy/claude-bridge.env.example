# Copy to /etc/claude-bridge.env, fill in, and lock it down:
#   sudo install -m 600 -o claude -g claude deploy/claude-bridge.env.example /etc/claude-bridge.env
#   sudo nano /etc/claude-bridge.env
#
# Headless auth for Claude Code. This bills through the Anthropic API
# (pay-per-token), not a Pro/Max subscription. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# If `claude` is not on the systemd service PATH (e.g. installed via nvm), don't
# rely on this file - instead set "claude_path" to the absolute path of the
# binary (run `which claude`) in bridge/config.json.
